# Copiar para .env.local e preencher. Nunca fazer commit de .env*.local.

# Ambiente lógico da app: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Segredo da Vercel Cron (mín. 32 caracteres). Gerar com: openssl rand -hex 32
CRON_SECRET=

# Sentry (opcional em dev: sem DSN fica desativado)
NEXT_PUBLIC_SENTRY_DSN=
# Só no CI/Vercel, para upload de source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
