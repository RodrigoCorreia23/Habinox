# Copiar para .env.local e preencher. Nunca fazer commit de .env*.local.

# Ambiente lógico da app: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Línguas visíveis na loja (pt,en,de,fr,it,es,nl). Vazio = só português.
# Em produção fica "pt" até o Bruno aprovar as traduções; em dev pode-se ver todas.
NEXT_PUBLIC_LOCALES=pt

# Postgres. Local: docker compose up -d
DATABASE_URL=postgres://abinox:abinox@localhost:5433/abinox

# Better Auth. Segredo: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend). Em development pode ficar vazio: os emails vão para o log.
RESEND_API_KEY=
EMAIL_FROM=

# Seed do primeiro admin (pnpm db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Segredo da Vercel Cron (mín. 32 caracteres). Gerar com: openssl rand -hex 32
CRON_SECRET=

# Sentry (opcional em dev: sem DSN fica desativado)
NEXT_PUBLIC_SENTRY_DSN=
# Só no CI/Vercel, para upload de source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Pasta onde ficam as imagens enviadas no backoffice (só em development).
# Por omissão: .data/uploads. Em staging/produção as imagens vão para o Cloudflare R2.
STORAGE_DIR=

# Tradução automática do catálogo (API da Anthropic, conta da Habinox). Vazio em dev = tradutor de teste.
ANTHROPIC_API_KEY=
